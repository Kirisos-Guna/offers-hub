# Copy to .env and fill in. Get these from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Live listener (listener.py; on the Hugging Face Space these are Space secrets)
# TG_SESSION_STRING=          (python login.py --string)
# FIREBASE_SERVICE_ACCOUNT={...service account key JSON...}
# CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud>

